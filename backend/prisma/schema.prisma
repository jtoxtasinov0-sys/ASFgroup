// ASF GROUP — ma'lumotlar bazasi sxemasi
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mijozlar (Telegram foydalanuvchilari)
model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String?
  lastName   String?
  username   String?
  phone      String?
  lang       String   @default("uz")
  seenIntro  Boolean  @default(false)
  isAdmin    Boolean  @default(false) /// Botda /admin PAROL orqali admin bo'lgan
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@map("users")
}

/// Mahsulotlar — tayyor oyoq kiyim va zagatovka (ustki qism)
model Product {
  id            Int      @id @default(autoincrement())
  article       String   @unique /// Artikul, masalan ASF-101
  name          String
  nameRu        String?
  description   String?
  descriptionRu String?
  category      String /// "ready" = tayyor oyoq kiyim | "upper" = zagatovka
  tag           String? /// "klassik" | "sport" | "mokasin" | "derbi" ...
  color         String?
  colorRu       String?
  material      String?
  materialRu    String?
  images        String[] @default([])
  imageFrames   Json     @default("{}") /// Rasm ko'rinishi: { "<url>": { r, z, x, y } } — kattalik va joylashuv
  imageColors   Json     @default("{}") /// Rasm rangi: { "<url>": "black" | "brown" | "blue" }
  price         Int /// Dona narxi (so'm)
  oldPrice      Int? /// Chizib tashlanadigan eski narx
  wholesalePrice Int /// Optom narxi (so'm)
  wholesaleMin   Int      @default(10) /// Shu sondan boshlab optom narx
  sizes         Int[]    @default([39, 40, 41, 42, 43])
  inStock       Boolean  @default(true)
  /// Ombor: optom uchun komplektlar soni (null — hisoblanmaydi, cheklov yo'q)
  stockPacks    Int?
  /// Ombor: dona savdo uchun razmer bo'yicha juftlar { "39": 5, "40": 12 } (null — hisoblanmaydi)
  stockPairs    Json?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stories Story[]

  @@index([category])
  @@map("products")
}

/// Buyurtmalar
model Order {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Json /// [{ productId, article, name, image, color, price, sizes: {"40":2,"41":3}, qty, lineTotal, stockTaken }]
  totalQty    Int      @default(0)
  total       Int
  isWholesale Boolean  @default(false)
  customerName String
  phone       String
  region      String
  address     String
  comment     String?
  paymentMethod String @default("cash") /// cash — naqd pul | click — Click orqali | card — kartaga o'tkazma (Uzcard/Humo)
  paymentStatus String    @default("unpaid") /// unpaid | pending (chek yuborilgan) | paid | rejected
  receiptUrl    String? /// Kartaga o'tkazma cheki rasmi
  receiptAt     DateTime? /// Chek yuborilgan vaqt
  status      String   @default("new") /// new | confirmed | delivered | cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

/// Admin paneldan o'zgartiriladigan sozlamalar (to'lov kartasi)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Storylar (bosh sahifadagi doiralar)
model Story {
  id        Int      @id @default(autoincrement())
  title     String
  titleRu   String?
  image     String
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("stories")
}
