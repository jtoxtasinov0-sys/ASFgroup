# ===== ASF GROUP — Backend sozlamalari =====

# Neon PostgreSQL ulanish manzili.
# Neon konsolidan "Connection string" ni nusxalab shu yerga qo'ying.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Telegram bot
BOT_TOKEN="BotFather bergan tokenni shu yerga yozing"

# Yangi buyurtma haqida xabar oladiganlar (Telegram chat ID, vergul bilan).
# O'z ID'ingizni bilish uchun botga /id deb yozing.
# Guruhga yuborish uchun: botni guruhga qo'shing va guruhda /id yozing (ID minus bilan boshlanadi).
ADMIN_CHAT_IDS=""

# Mini App manzili (ngrok ishga tushgach shu yerga yoziladi)
MINIAPP_URL="http://localhost:5173"

# Server
PORT=5000
PUBLIC_URL="http://localhost:5000"

# Admin panelga kirish
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="kuchli-parol-yozing"
JWT_SECRET="tasodifiy-uzun-maxfiy-kalit-yozing"

# Kompaniya
COMPANY_PHONE="+998 90 123 45 67"
COMPANY_ADDRESS="Toshkent sh."

# Kartaga o'tkazma (Admin panel -> Sozlamalar bo'limidan kiritish qulayroq)
