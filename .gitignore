.env
.env.local
.env.*.local
# Bular maxfiy emas (faqat VITE_API_URL) — saqlanadi:
!.env.example
!.env.development
!.env.production

# --- Backend yuklangan fayllar ---
backend/uploads/products/custom-*
backend/uploads/stories/*
